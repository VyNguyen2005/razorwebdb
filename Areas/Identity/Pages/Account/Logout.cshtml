@page "/logout/"
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit" class="btn btn-danger">Nhấn vào đây để đăng xuất</button>
            </form>
        }
        else
        {
            <p>Bạn đã thành công đăng xuất khỏi trang web.</p>
        }
    }
</header>
